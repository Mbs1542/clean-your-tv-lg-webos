{
  "schemaVersion": 1,
  "themeApiVersion": 1,
  "id": "github:razdva122/clean-your-tv-lg-webos:itachi",
  "title": "Itachi · Sharingan",
  "description": "Dark Itachi wallpaper and CSS-only white logo effects. Original application images remain unchanged.",
  "author": {
    "name": "CYTV personal themes",
    "url": "https://github.com/razdva122"
  },
  "themeVersion": "1.0.1",
  "layout": {
    "preset": "scenic-grid",
    "columns": 5,
    "allowColumnOverride": false,
    "spacingScale": 1,
    "textScale": 1,
    "focusScale": 1.1
  },
  "defaults": {
    "wallpaperAssetId": "wallpaper",
    "dim": 0,
    "accent": "#ffffff"
  },
  "assets": [
    {
      "id": "wallpaper",
      "path": "assets/wallpaper.png",
      "mediaType": "image/png",
      "width": 1672,
      "height": 941
    },
    {
      "id": "preview",
      "path": "assets/preview.jpg",
      "mediaType": "image/jpeg",
      "width": 960,
      "height": 540
    }
  ],
  "previewAssetId": "preview",
  "license": {
    "identifier": "LicenseRef-Personal-Fan-Theme",
    "textPath": "LICENSE.txt",
    "creditsPath": "CREDITS.txt"
  }
}
